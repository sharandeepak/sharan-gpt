# Firebase Admin (server only — never expose these to the client)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# IMPORTANT: paste the full private key wrapped in quotes; literal \n sequences
# are converted to newlines at runtime by lib/firebase-admin.ts.
FIREBASE_PRIVATE_KEY=""

# AI provider — set ONE of these.
# Use OPENAI_API_KEY for direct OpenAI usage, or AI_GATEWAY_API_KEY for the
# Vercel AI Gateway (recommended in production).
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# The model id passed to the AI SDK. Defaults to gpt-4o-mini if unset.
AI_MODEL=gpt-4o-mini

# Admin password. Required to view /admin.
ADMIN_PASSWORD=

# Optional: a 32+ char random string used to sign the admin session cookie.
# If unset, falls back to a hash of ADMIN_PASSWORD (still safe, just less ideal).
ADMIN_SESSION_SECRET=

# Optional: the public origin of the site, used in absolute links inside admin
# emails or analytics exports. Not required for the app to run.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
